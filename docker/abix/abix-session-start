#!/bin/bash
# Started by supervisord (as user abix) instead of the old inline command.
# 1) same prerequisites as before  2) seed Abix desktop config (first run / reset only)  3) start Xfce.
mkdir -p /tmp/runtime-abix && chmod 700 /tmp/runtime-abix
sleep 3
# Seeding must never block the desktop: if it fails we still get a normal Xfce.
/usr/local/bin/abix-ctl seed || echo "[abix] seed failed - starting stock Xfce"
exec dbus-launch --exit-with-session startxfce4
