def ensure_user_dirs():
    for n in ("Desktop", "Documents", "Downloads", "Pictures", "Pictures/Wallpapers", "Music", "Videos", "Workspace"):
        os.makedirs(os.path.join(HOME, n), exist_ok=True)


def cmd_seed(force=False):
    force = force or os.environ.get("ABIX_RESET_DESKTOP") == "1" or os.path.exists(os.path.join(CFG, "force-reset"))
    os.makedirs(CFG, exist_ok=True)
    ensure_user_dirs()
    if not os.path.exists(SETTINGS):
        save_settings(load_settings())
    cur = ""
    try:
        with open(MARKER) as f:
            cur = f.read().strip()
    except OSError:
        pass
    if cur == PROFILE_VERSION and not force:
        return {"seeded": False, "reason": "already at " + PROFILE_VERSION}
    backup = backup_old_config()
    s = load_settings()
    info = gen_panel(s["THEME"])
    info["desktop_icons"] = gen_desktop_icons()
    gen_terminal_rc()
    with open(MARKER, "w") as f:
        f.write(PROFILE_VERSION)
    try:
        os.remove(os.path.join(CFG, "force-reset"))
    except OSError:
        pass
    info.update({"seeded": True, "backup": backup})
    return info


# ----------------------------------------------------------------- commands
def cmd_apply():
    s = load_settings()
    res = {"theme": apply_theme(s), "wm": None}
    apply_wm_behaviour()
    if not apply_wallpaper(s["WALLPAPER"]):
        apply_wallpaper(DEFAULTS["WALLPAPER"])
    anim = apply_animation(s["ANIMATION"])
    res["animation"] = anim
    st = load_state()
    st.update({"animation": anim, "theme": res["theme"], "applied_at": int(time.time())})
    save_state(st)
    return res


def cmd_status():
    s = load_settings()
    st = load_state()
    return {
        "settings": s,
        "profile_version": open(MARKER).read().strip() if os.path.exists(MARKER) else None,
        "active": st,
        "detected": {
            "gtk_theme_light": pick_gtk_theme("light"), "gtk_theme_dark": pick_gtk_theme("dark"),
            "icons": pick_icons(s["THEME"]), "cursor": pick_cursor(), "font": pick_font(),
            "whisker_menu": has_whisker(), "picom": have("picom"),
            "wallpapers": sorted(os.path.basename(p) for p in glob.glob(SYS_WALLS + "/*") if p.lower().endswith(IMG_EXT)),
        },
    }


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = argv[1], argv[2:]
    try:
        if cmd == "status":
            print(json.dumps(cmd_status(), indent=2))
        elif cmd == "seed":
            print(json.dumps(cmd_seed("--force" in args)))
        elif cmd == "apply":
            print(json.dumps(cmd_apply()))
        elif cmd == "theme" and args and args[0] in THEMES:
            s = load_settings()
            s["THEME"] = args[0]
            # switching mode swaps between the two bundled wallpapers only if the user still uses a default one
            if os.path.basename(s["WALLPAPER"]) in ("abix-bloom-light.jpg", "abix-bloom-dark.jpg"):
                s["WALLPAPER"] = SYS_WALLS + "/abix-bloom-%s.jpg" % args[0]
            save_settings(s)
            print(json.dumps(cmd_apply()))
        elif cmd == "anim" and args and args[0] in ANIMS:
            s = load_settings()
            s["ANIMATION"] = args[0]
            save_settings(s)
            res = apply_animation(args[0])
            st = load_state()
            st["animation"] = res
            save_state(st)
            print(json.dumps(res))
        elif cmd == "accent" and args and re.fullmatch(r"#[0-9a-fA-F]{6}", args[0]):
            s = load_settings()
            s["ACCENT"] = args[0]
            save_settings(s)
            write_gtk_css(s["THEME"], s["ACCENT"])
            print(json.dumps({"accent": args[0], "note": "new windows pick it up; open apps may need a restart"}))
        elif cmd == "wallpaper" and args:
            if not apply_wallpaper(args[0]):
                print("refused: file must be an image (<=30 MB) inside Pictures, Downloads or the Abix wallpaper folder", file=sys.stderr)
                return 2
            s = load_settings()
            s["WALLPAPER"] = os.path.realpath(args[0])
            save_settings(s)
            print(json.dumps({"wallpaper": s["WALLPAPER"]}))
        elif cmd == "wallpaper-add" and args:
            src = os.path.realpath(args[0])
            if not (src.lower().endswith(IMG_EXT) and os.path.isfile(src) and os.path.getsize(src) <= MAX_WALL_BYTES):
                print("refused: not an image file or bigger than 30 MB", file=sys.stderr)
                return 2
            os.makedirs(USER_WALLS, exist_ok=True)
            name = re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(src))
            dst = os.path.join(USER_WALLS, name)
            shutil.copy(src, dst)
            if not apply_wallpaper(dst):
                return 2
            s = load_settings()
            s["WALLPAPER"] = dst
            save_settings(s)
            print(json.dumps({"wallpaper": dst}))
        elif cmd == "get-theme":
            rc, out = run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"])
            print(out)
            return 0 if rc == 0 and out else 1
        elif cmd == "restart-session":
            run(["xfce4-session-logout", "--logout", "--fast"])
        else:
            print("unknown or invalid command. Try: abix-ctl help", file=sys.stderr)
            return 1
    except Exception as e:  # never crash the session start because of cosmetics
        print("abix-ctl error: %s: %s" % (type(e).__name__, e), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
