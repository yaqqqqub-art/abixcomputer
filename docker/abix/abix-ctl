def gen_desktop_icons():
    d = os.path.join(HOME, "Desktop")
    os.makedirs(d, exist_ok=True)
    made = []
    for names in desktop_candidates():
        n, p = resolve_desktop(names)
        if n:
            dst = os.path.join(d, n)
            shutil.copy(p, dst)
            os.chmod(dst, 0o755)
            made.append(n)
    return made


