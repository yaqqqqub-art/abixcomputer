# Copy to .env (deployment/init.sh does this for you with random secrets). Never commit .env.
VNC_PASSWORD=change-me
DESKTOP_GEOMETRY=1280x800
DESKTOP_MEM_LIMIT=4g
DESKTOP_CPUS=3.0
HTTP_PORT=80
HTTPS_PORT=443
# --- Stage 1 (desktop look). All optional. ---
ABIX_DEFAULT_THEME=light
ABIX_DEFAULT_ANIMATION=light
ABIX_RESET_DESKTOP=0
ABIX_FLUENT=1
# --- Stage 2 (web login). deployment/init.sh fills these in. ---
ABIX_ADMIN_USER=admin
ABIX_ADMIN_HASH=
ABIX_SECRET=
ABIX_SESSION_HOURS=8
ABIX_WINE=1
ABIX_MAX_UPLOAD_MB=512
# --- Stage 4 (optional) ---
# Fixed public address through Cloudflare Tunnel (see docker-compose.public.yml). Leave empty for a temporary link.
CLOUDFLARE_TUNNEL_TOKEN=
# --- Stage 5 (App Center + smoothness). All optional. ---
ABIX_FPS=60
ABIX_APPS_RESTORE=1
ABIX_MAX_DOWNLOAD_MB=2048
ABIX_EXTRA_APT=
